# Public frontend configuration. Use a publishable key or legacy anon key, NEVER service_role.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
# Set only after enabling the GitHub OAuth provider in Supabase.
VITE_GITHUB_LOGIN_ENABLED=false
# Resend-managed receiving domain; enable only after verified webhook setup.
VITE_MAIL_RECEIVING_DOMAIN=
